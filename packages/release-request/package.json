{
  "name": "@6529-collections/release-request",
  "version": "0.0.5",
  "description": "Create, validate, and submit 6529 release-request files.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "6529-release-request": "bin/6529-release-request.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./release-request.schema.json",
    "./schema/v0.000001": "./release-request.schema.v0.000001.json",
    "./example": "./release-request.example.json",
    "./monitoring-example": "./release-request.monitoring.example.json"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "release-request.schema.json",
    "release-request.schema.v0.000001.json",
    "release-request.example.json",
    "release-request.monitoring.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6529-Collections/6529-release-coordinator.git",
    "directory": "packages/release-request"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
